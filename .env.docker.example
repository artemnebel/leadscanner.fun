# ── Local Docker dev env — copy to .env.docker (gitignored) and fill in ────────
# This is DEV ONLY. Never put live Stripe/production keys here. The Docker
# container reads ONLY this file (host .env / .env.local are masked inside it).

# Points at the Postgres service in docker-compose (NOT production).
DATABASE_URL=postgresql://leadscanner:leadscanner@db:5432/leadscanner

BASE_URL=http://localhost:8000
JWT_SECRET=change-me-dev-only          # any long random string for local dev
ADMIN_EMAIL=you@example.com            # this account is admin + always Pro in dev

# Needed for scanning to actually return leads in dev (your Google Places key).
GOOGLE_MAPS_API_KEY=

# Separate, HTTP-referrer-restricted key for the browser map (Maps JS API).
# Without this the map loads unauthenticated and shows Google's
# "For development purposes only" watermark with no custom styling.
# Make sure its referrer restrictions include http://localhost:8000/*
GOOGLE_MAPS_JS_API_KEY=

# ── Leave blank in dev (do NOT use live values) ────────────────────────────────
# Stripe: use TEST keys only if you need to exercise billing locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
# Email (Resend): leave blank so dev never sends real emails.
RESEND_API_KEY=
# Social login (Google/Facebook/GitHub): only work if you register
# http://localhost:8000/... callback URLs; otherwise leave blank.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
